#!/bin/bash
# ==========================================
# DevKit - 開發工具包 CLI
# 作者: 李卡爾
# 功能: 統一管理和執行所有開發腳本工具
# 使用方式: devkit [command] [options]
# ==========================================

# 腳本基本路徑
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="$SCRIPT_DIR"
PACKAGE_JSON="$SCRIPT_DIR/package.json"

# 彩色輸出
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# 將字串首字母轉為大寫（可攜帶式，不依賴 GNU sed \U）
title_case() {
    local word="$1"
    if [ -z "$word" ]; then
        printf ''
        return
    fi
    local first rest
    first=$(printf '%s' "${word:0:1}" | tr '[:lower:]' '[:upper:]')
    rest="${word:1}"
    printf '%s%s' "$first" "$rest"
}

# 統一錯誤輸出：紅色 + 「錯誤：」前綴 + stderr
print_error() {
    echo -e "${RED}錯誤：$1${NC}" >&2
}

# 從 package.json 讀取版本號
get_version() {
    if [ -f "$PACKAGE_JSON" ]; then
        # 使用 grep 和 sed 提取版本號（更簡單可靠的方法）
        grep '"version"' "$PACKAGE_JSON" | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/' | tr -d '[:space:]'
    else
        echo "0.0.0"
    fi
}

VERSION=$(get_version)

# 顯示版本資訊
show_version() {
    echo -e "${BOLD}DevKit v${VERSION}${NC}"
    echo "開發工具包 - 統一管理所有開發腳本"
}

# 顯示使用說明
show_help() {
    show_version
    echo ""
    echo -e "${CYAN}使用方式：${NC}"
    echo "  devkit [command] [options]"
    echo ""
    echo -e "${CYAN}命令：${NC}"
    echo "  list                     顯示所有可用工具"
    echo "  <category>               顯示特定分類的工具"
    echo "  <category>:<tool>        執行指定工具"
    echo "  --interactive, -i        互動式選單"
    echo "  --help, -h               顯示此說明"
    echo "  --version, -v            顯示版本資訊"
    echo ""
    echo -e "${CYAN}範例：${NC}"
    echo "  devkit                   # 顯示所有工具"
    echo "  devkit git               # 顯示 git 工具"
    echo "  devkit git:release-tag   # 執行版本標籤工具"
    echo "  devkit -i                # 互動式選單"
}

# 獲取所有分類
get_categories() {
    # 掃描 bash-tools 目錄
    for category_dir in "$TOOLS_DIR"/bash-tools/*/; do
        if [ -d "$category_dir" ]; then
            local category_name=$(basename "$category_dir")
            
            # 跳過隱藏目錄和非工具目錄
            if [[ "$category_name" != .* ]] && [[ "$category_name" != "node_modules" ]]; then
                # 檢查是否有 .sh 檔案
                if ls "$category_dir"/*.sh >/dev/null 2>&1; then
                    echo "$category_name"
                fi
            fi
        fi
    done
    
    # 掃描 node-tools 目錄
    for category_dir in "$TOOLS_DIR"/node-tools/*/; do
        if [ -d "$category_dir" ]; then
            local category_name=$(basename "$category_dir")
            
            # 跳過隱藏目錄和非工具目錄
            if [[ "$category_name" != .* ]] && [[ "$category_name" != "node_modules" ]]; then
                # 檢查是否有 package.json 或 CLI 入口
                if [ -f "$category_dir/package.json" ] || [ -f "$category_dir/src/cli.js" ]; then
                    echo "$category_name"
                fi
            fi
        fi
    done
}

# 獲取分類下的工具
get_category_tools() {
    local category="$1"
    local bash_category_dir="$TOOLS_DIR/bash-tools/$category"
    local node_category_dir="$TOOLS_DIR/node-tools/$category"
    
    # 檢查 bash-tools 目錄
    if [ -d "$bash_category_dir" ]; then
        for script_file in "$bash_category_dir"/*.sh; do
            if [ -f "$script_file" ]; then
                local tool_name=$(basename "$script_file" .sh)
                local description=""
                
                # 嘗試從腳本中提取描述
                description=$(grep "^# DEVKIT_DESC:" "$script_file" 2>/dev/null | sed 's/^# DEVKIT_DESC: *//' | head -1)
                if [ -z "$description" ]; then
                    description=$(grep "^# 功能:" "$script_file" 2>/dev/null | sed 's/^# 功能: *//' | head -1)
                fi
                if [ -z "$description" ]; then
                    description="$tool_name 工具"
                fi
                
                echo "$tool_name|$script_file|$description"
            fi
        done
    fi
    
    # 檢查 node-tools 目錄
    if [ -d "$node_category_dir" ]; then
        # Node.js 工具通常有統一的 CLI 入口
        if [ -f "$node_category_dir/src/cli.js" ]; then
            # 從 package.json 取得描述
            local description=""
            if [ -f "$node_category_dir/package.json" ]; then
                description=$(grep '"description"' "$node_category_dir/package.json" 2>/dev/null | sed 's/.*"description": *"\([^"]*\)".*/\1/')
            fi
            if [ -z "$description" ]; then
                description="$category Node.js 工具"
            fi
            
            echo "$category|$node_category_dir/src/cli.js|$description"
        fi
    fi
}

# 顯示所有工具清單
show_all_tools() {
    echo -e "${BOLD}🛠️  Development Toolkit${NC}"
    echo ""
    
    local categories=($(get_categories))
    
    if [ ${#categories[@]} -eq 0 ]; then
        echo -e "${YELLOW}⚠️  沒有找到任何工具${NC}"
        echo -e "${CYAN}💡 請確認目錄結構完整：需要 bash-tools/ 和 node-tools/ 子目錄${NC}"
        return
    fi
    
    echo -e "${CYAN}📂 可用分類：${NC}"
    for category in "${categories[@]}"; do
        local tool_count
        tool_count=$(get_category_tools "$category" | wc -l | tr -d '[:space:]')
        local category_display
        category_display=$(title_case "$category")
        echo "  $category     - $category_display 相關工具 ($tool_count 個工具)"
    done
    
    echo ""
    echo -e "${CYAN}🔧 所有工具：${NC}"
    
    for category in "${categories[@]}"; do
        local category_display
        category_display=$(title_case "$category")
        echo -e "${BOLD}  $category_display:${NC}"
        
        get_category_tools "$category" | while IFS='|' read -r tool_name script_path description; do
            echo "    $tool_name  - $description"
        done
        echo ""
    done
    
    echo -e "${CYAN}💡 使用方式：${NC}"
    echo "  devkit <category>                # 顯示分類工具"
    echo "  devkit <category>:<tool>         # 執行指定工具"
    echo "  devkit --help <category>:<tool>  # 顯示工具說明"
}

# 顯示特定分類的工具
show_category_tools() {
    local category="$1"
    
    local categories=($(get_categories))
    local category_exists=false
    
    for cat in "${categories[@]}"; do
        if [ "$cat" = "$category" ]; then
            category_exists=true
            break
        fi
    done
    
    if [ "$category_exists" = false ]; then
        echo -e "${RED}❌ 分類 '$category' 不存在${NC}"
        echo ""
        echo -e "${CYAN}可用分類：${NC}"
        for cat in "${categories[@]}"; do
            echo "  $cat"
        done
        return 1
    fi
    
    local category_display
    category_display=$(title_case "$category")
    echo -e "${BOLD}🔧 $category_display 工具：${NC}"
    echo ""
    
    local tools=($(get_category_tools "$category"))
    
    if [ ${#tools[@]} -eq 0 ]; then
        echo -e "${YELLOW}⚠️  該分類下沒有可用工具${NC}"
        return
    fi
    
    get_category_tools "$category" | while IFS='|' read -r tool_name script_path description; do
        echo "  $tool_name  - $description"
    done
    
    echo ""
    echo -e "${CYAN}💡 使用方式：${NC}"
    echo "  devkit ${category}:<tool>  # 執行指定工具"
}

# 執行指定工具
execute_tool() {
    local tool_spec="$1"
    shift
    local args="$@"
    
    # 解析 category:tool 格式
    if [[ "$tool_spec" != *":"* ]]; then
        echo -e "${RED}❌ 工具格式錯誤，應為 category:tool${NC}"
        return 1
    fi
    
    local category="${tool_spec%:*}"
    local tool_name="${tool_spec#*:}"
    
    # 查找工具
    local found_tool=$(get_category_tools "$category" | grep "^${tool_name}|")
    
    if [ -z "$found_tool" ]; then
        echo -e "${RED}❌ 工具 '$tool_spec' 不存在${NC}"
        echo ""
        echo -e "${CYAN}該分類下的可用工具：${NC}"
        get_category_tools "$category" | while IFS='|' read -r name path desc; do
            echo "  devkit ${category}:${name}"
        done
        return 1
    fi
    
    local script_path=$(echo "$found_tool" | cut -d'|' -f2)
    local description=$(echo "$found_tool" | cut -d'|' -f3)
    
    echo -e "${BLUE}🚀 執行工具：$tool_spec${NC}"
    echo -e "${CYAN}描述：$description${NC}"
    echo ""
    
    # 檢查腳本是否存在
    if [ ! -f "$script_path" ]; then
        echo -e "${RED}❌ 腳本檔案不存在：$script_path${NC}"
        return 1
    fi
    
    # 判斷是 Bash 工具還是 Node.js 工具
    if [[ "$script_path" == *"/bash-tools/"* ]]; then
        # Bash 工具
        execute_bash_tool "$script_path" $args
    elif [[ "$script_path" == *"/node-tools/"* ]]; then
        # Node.js 工具
        execute_node_tool "$category" "$tool_name" $args
    else
        echo -e "${RED}❌ 無法識別工具類型：$script_path${NC}"
        return 1
    fi
}

# 執行 Bash 工具
execute_bash_tool() {
    local script_path="$1"
    shift
    local args="$@"
    
    # 檢查腳本是否可執行
    if [ ! -x "$script_path" ]; then
        echo -e "${YELLOW}⚠️  設定腳本執行權限...${NC}"
        chmod +x "$script_path"
    fi
    
    # 執行腳本
    "$script_path" $args
}

# 執行 Node.js 工具
execute_node_tool() {
    local category="$1"
    local tool_name="$2"
    shift 2
    local args="$@"
    
    local node_tool_dir="$TOOLS_DIR/node-tools/$category"
    local invocation_dir="$(pwd)"
    
    # 檢查 Node.js 和 pnpm
    if ! command -v node &> /dev/null; then
        echo -e "${RED}❌ 需要 Node.js 18+ 才能執行此工具${NC}"
        return 1
    fi
    
    # 檢查 Node.js 版本
    local node_version=$(node -v | sed 's/v//')
    local min_version="18.0.0"
    local max_version="23.99.99"
    
    # 檢查最低版本
    if [[ "$(printf '%s\n' "$min_version" "$node_version" | sort -V | head -n1)" != "$min_version" ]]; then
        echo -e "${RED}❌ 需要 Node.js $min_version 或更高版本，當前版本: $node_version${NC}"
        return 1
    fi
    
    # 檢查最高版本（警告）
    if [[ "$(printf '%s\n' "$max_version" "$node_version" | sort -V | head -n1)" != "$node_version" ]]; then
        echo -e "${YELLOW}⚠️  Node.js 版本 $node_version 可能未經完整測試${NC}"
        echo -e "${CYAN}💡 建議使用 Node.js 18.x、20.x 或 22.x LTS 版本${NC}"
        echo -e "${CYAN}💡 如遇到問題，請參考 scripts/UPGRADE.md${NC}"
    fi
    
    # 確保根層級依賴已安裝
    if [ ! -d "$TOOLS_DIR/node_modules" ]; then
        echo -e "${YELLOW}⚠️  安裝共用依賴...${NC}"
        cd "$TOOLS_DIR" && pnpm install
    fi
    
    # 確保工具依賴已安裝
    if [ -f "$node_tool_dir/package.json" ] && [ ! -d "$node_tool_dir/node_modules" ]; then
        echo -e "${YELLOW}⚠️  安裝工具依賴...${NC}"
        cd "$node_tool_dir" && pnpm install
    fi
    
    # 執行 Node.js 工具
    cd "$node_tool_dir"
    
    # 如果工具名稱與分類相同，直接執行 CLI
    if [ "$tool_name" = "$category" ]; then
        DEVKIT_ORIGINAL_CWD="${DEVKIT_ORIGINAL_CWD:-$invocation_dir}" DEVKIT_PROJECT_PATH="${DEVKIT_PROJECT_PATH:-$invocation_dir}" node src/cli.js $args
    else
        # 否則傳遞工具名稱作為子命令
        DEVKIT_ORIGINAL_CWD="${DEVKIT_ORIGINAL_CWD:-$invocation_dir}" DEVKIT_PROJECT_PATH="${DEVKIT_PROJECT_PATH:-$invocation_dir}" node src/cli.js "$tool_name" $args
    fi
}

# 互動式選單
interactive_menu() {
    while true; do
        clear
        echo -e "${BOLD}🛠️  Development Toolkit - 互動式選單${NC}"
        echo ""
        
        local categories=($(get_categories))
        
        if [ ${#categories[@]} -eq 0 ]; then
            echo -e "${YELLOW}⚠️  沒有找到任何工具${NC}"
            return
        fi
        
        echo -e "${CYAN}請選擇分類：${NC}"
        local i=1
        
        for category in "${categories[@]}"; do
            local tool_count
            tool_count=$(get_category_tools "$category" | wc -l | tr -d '[:space:]')
            echo "  $i. $category ($tool_count 個工具)"
            ((i++))
        done
        
        echo "  $i. 退出"
        echo ""
        
        read -p "請輸入選項 (1-$i): " choice
        
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
            if [ "$choice" -eq "$i" ]; then
                echo -e "${YELLOW}👋 再見！${NC}"
                break
            fi
            
            local selected_category="${categories[$((choice-1))]}"
            interactive_category_menu "$selected_category"
        else
            echo -e "${RED}❌ 無效選項，請重新選擇${NC}"
            read -p "按 Enter 繼續..."
        fi
    done
}

# 互動式分類選單
interactive_category_menu() {
    local category="$1"
    
    while true; do
        clear
        local category_display
        category_display=$(title_case "$category")
        echo -e "${BOLD}🔧 $category_display 工具選單${NC}"
        echo ""
        
        local tools_info=($(get_category_tools "$category"))
        local i=1
        
        get_category_tools "$category" | while IFS='|' read -r tool_name script_path description; do
            echo "  $i. $tool_name - $description"
            ((i++))
        done
        
        echo "  $i. 返回上級選單"
        echo ""
        
        read -p "請輸入選項 (1-$i): " choice
        
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
            if [ "$choice" -eq "$i" ]; then
                break
            fi
            
            # 獲取選中的工具
            local selected_tool=$(get_category_tools "$category" | sed -n "${choice}p" | cut -d'|' -f1)
            
            if [ -n "$selected_tool" ]; then
                echo ""
                execute_tool "${category}:${selected_tool}"
                echo ""
                read -p "按 Enter 繼續..."
            fi
        else
            echo -e "${RED}❌ 無效選項，請重新選擇${NC}"
            read -p "按 Enter 繼續..."
        fi
    done
}


# 主程式
main() {
    # 解析命令列參數
    case "${1:-}" in
        ""|"list")
            show_all_tools
            ;;
        "--help"|"-h")
            show_help
            ;;
        "--version"|"-v")
            show_version
            ;;
        "--interactive"|"-i")
            interactive_menu
            ;;
        *":"*)
            # 執行指定工具
            execute_tool "$@"
            ;;
        *)
            # 顯示分類
            show_category_tools "$1"
            ;;
    esac
}

# 執行主程式
main "$@"